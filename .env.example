# Optional. Mock mode works without any API keys or Internet after installation.
PORT=3000
# Relative to project root. Keep this outside public/.
DATA_DIR=./data
LLM_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=
TTS_API_KEY=
# Optional uploaded/reusable character voices via ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Conservative USD estimate per speech segment, reserving two attempts.
ELEVENLABS_TTS_COST_ESTIMATE=
# Required conservative USD estimates before enabling paid worker calls.
# Legacy jobs require explicit estimates. New realism posts use floors of
# $0.30/image and $0.10/voice attempt, or your higher configured estimates.
# Video floors: gen4.5 $0.12/generated second; gen4_turbo $0.05.
# Check current provider pricing and keep estimates conservative.
IMAGE_COST_ESTIMATE=
VIDEO_COST_PER_SECOND=
TTS_COST_ESTIMATE=
# TTS_COST_ESTIMATE is per voice segment; two attempts are reserved for new takes.
# Optional absolute path if ffmpeg.exe is not on PATH.
FFMPEG_PATH=ffmpeg
# Optional when ffprobe is not beside FFMPEG_PATH or on PATH.
FFPROBE_PATH=
# Optional speaking-to-camera rendering. Voiceover videos do not need this.
LIPSYNC_API_KEY=
LIPSYNC_MODEL=lipsync-2-pro
# Conservative estimate per lip-synced second. No default price is assumed.
LIPSYNC_COST_PER_SECOND=
